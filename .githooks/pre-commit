#!/usr/bin/env bash
# Self-contained pre-commit guard: blocks commits that reintroduce real
# infrastructure identifiers into this repo. Activate once per clone with:
#     git config core.hooksPath .githooks
# (or use the pre-commit framework via .pre-commit-config.yaml).
set -uo pipefail

# Patterns that must never be committed (real hostnames / domains / IPs / org).
# Placeholder equivalents are allowed: example.local, 10.20.x, 172.31.222.x,
# 192.0.2.x, DEMO-*, szdemo, corp.local, etc.
PATTERNS='(example.local|example|example.net|\bAHD-[A-Za-z0-9]|\bAHD\b|\bdemolab\b|appsrv1|EXAMPLE-CORP|EXAMPLE-CORP|10.20.[0-9]+\.[0-9]+|10.20.[0-9]+\.[0-9]+|10.20.[0-9]+|10.20.[0-9]+|10.20.[0-9]+|10.20.[0-9]+|172\.(2[0-9]|30)\.200\.[0-9]+)'

# Only scan staged, added/changed text content.
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

hits=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  # the security config legitimately names these patterns as detection rules
  case "$f" in .githooks/pre-commit|.gitleaks.toml|.pre-commit-config.yaml) continue ;; esac
  # skip obvious binaries
  if git diff --cached --numstat -- "$f" | grep -q '^-'; then :; fi
  match=$(git show ":$f" 2>/dev/null | grep -nEI "$PATTERNS" || true)
  if [ -n "$match" ]; then
    echo "BLOCKED: real infrastructure identifier in $f"
    echo "$match" | head -5 | sed 's/^/    /'
    hits=1
  fi
done <<< "$files"

if [ "$hits" -ne 0 ]; then
  echo ""
  echo "Commit blocked by .githooks/pre-commit — replace real values with placeholders"
  echo "(example.local, 10.20.x, 172.31.222.x, 192.0.2.x, DEMO-*, szdemo)."
  echo "To bypass in a genuine false positive: git commit --no-verify"
  exit 1
fi
exit 0
